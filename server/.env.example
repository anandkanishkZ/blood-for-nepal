# Environment
NODE_ENV=development

# Server Configuration
PORT=5000
API_PREFIX=/api/v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blood_for_nepal
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_for_development
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@bloodfornepal.org

# SMS Configuration (BiraSMS)
BIRA_SMS_API_KEY=your_birasms_api_key_here
BIRA_SMS_ROUTE_ID=SI_Alert
BIRA_SMS_USERNAME=your_birasms_username_here
BIRA_SMS_PASSWORD=your_birasms_password_here
BIRA_SMS_CAMPAIGN=Default
# Set to false to disable development mode fallback
BIRA_SMS_DEV_MODE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12
